#H3:
def count (items, target):
  total = 0
  for item in items:
    if item == target:
      total += 1
  return total
votes = []
while True:
  vote = input('Vote ( done to stop): ')
  if vote == 'done':
    break
  votes.append(vote)
candidate = input('Candidate: ')
print(f'{candidate} got {count(votes, candidate)} vote(s).')
